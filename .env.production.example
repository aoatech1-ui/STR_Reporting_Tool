# Copy to .env (chmod 600) and fill in. Never commit .env.
# Used by docker-compose.yml; the same names configure the app when run without Docker (see .env.example).

# ---- Required ----
DOMAIN=statements.yourcompany.com          # DNS A/AAAA record must point at this server
POSTGRES_PASSWORD=                         # openssl rand -hex 24   (hex avoids URL-encoding problems)
LINK_SECRET=                               # openssl rand -base64 48   (signs owner statement links; rotating invalidates sent links)

# ---- Email: pick ONE provider, see docs/gmail-setup.md or .env.example for all options ----
EMAIL_PROVIDER=
EMAIL_FROM="Your Company <statements@yourcompany.com>"
# RESEND_API_KEY= / BREVO_API_KEY= / MAILJET_API_KEY= + MAILJET_API_SECRET= / MAILERSEND_API_TOKEN= / POSTMARK_SERVER_TOKEN= / SENDGRID_API_KEY= / MAILGUN_API_KEY= + MAILGUN_DOMAIN=
# Gmail: EMAIL_PROVIDER=gmail  SMTP_USER=<mailbox>  SMTP_PASS=<16-char app password, no spaces>
# Delivery-status callbacks (recommended for non-SMTP providers). Webhook URL: https://<DOMAIN>/webhooks/email/<provider>
EMAIL_WEBHOOK_TOKEN=                       # brevo / mailjet / postmark / sendgrid: append ?token=<this> to the webhook URL
EMAIL_WEBHOOK_SECRET=                      # resend (whsec_...), mailersend, mailgun signing secret

# ---- Files (receipts + archived statement PDFs/CSVs) ----
# Default: Docker volume "files" on this server (included in scripts/backup.sh). For S3-compatible storage instead:
# FILE_STORE=s3  S3_BUCKET=  S3_REGION=  S3_ENDPOINT=  S3_ACCESS_KEY_ID=  S3_SECRET_ACCESS_KEY=

# ---- Optional ----
LOG_LEVEL=info
LOGIN_RATE_LIMIT=10
BACKUP_KEEP_DAYS=14
BACKUP_PASSPHRASE=                         # if set, backups are encrypted with AES-256 (gpg). Store it OUTSIDE this server too.
# APP_IMAGE=ghcr.io/you/str-owner-accounting:1.0.0   # to deploy a prebuilt image instead of building on the server
