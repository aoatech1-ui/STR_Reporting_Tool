# --- Required ---
DATABASE_URL=postgres://user:pass@localhost:5432/str
BASE_URL=https://app.example.com          # public URL; must be https outside localhost. Used for cookies, Origin checks and statement links
LINK_SECRET=                              # >= 32 random chars (openssl rand -base64 32). Signs owner statement links. Rotating it invalidates sent links.

# --- Server ---
PORT=3000
HOST=0.0.0.0
TRUST_PROXY=false                         # true behind a reverse proxy so rate limits/audit see the real client IP
ALLOWED_ORIGINS=                          # extra comma-separated browser origins allowed to call the API
LOGIN_RATE_LIMIT=10                       # login attempts per IP per minute
MIGRATE_ON_START=false

# --- Email (pick ONE provider) ---
# brevo | resend | mailjet | mailersend | postmark | sendgrid | mailgun   (transactional – recommended)
# gmail | outlook | office365 | yahoo | aol | zoho | icloud | fastmail | ses | custom   (SMTP)
EMAIL_PROVIDER=
EMAIL_FROM="Your Company <statements@yourdomain.com>"   # must be a sender/domain verified with the provider (SPF + DKIM)
BREVO_API_KEY=
RESEND_API_KEY=
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILERSEND_API_TOKEN=
POSTMARK_SERVER_TOKEN=
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_REGION=us                         # or eu
# SMTP presets (gmail, outlook, ...). Use an APP PASSWORD, never the account password.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=                                # override preset host (zoho.eu, SES region, custom)
SMTP_PORT=
SMTP_SECURE=

# --- Delivery-status webhooks (optional but recommended) ---
EMAIL_WEBHOOK_TOKEN=                      # brevo / mailjet / postmark / sendgrid: add ?token=<this> to the webhook URL
EMAIL_WEBHOOK_SECRET=                     # resend (whsec_...), mailersend, mailgun signing secret
